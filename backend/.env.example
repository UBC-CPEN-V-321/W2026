# Server configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/cpen321

# Ticketmaster event search
TICKETMASTER_API_KEY=your_ticketmaster_api_key
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2
EVENT_SEARCH_STATE_CODE=BC
EVENT_SEARCH_COUNTRY_CODE=CA
EVENT_SEARCH_PAGE_SIZE=200

# Google authentication
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ExploreUBC session inactivity window (in days)
SESSION_TTL_DAYS=1

# Google Maps Platform
MAPS_API_KEY=your_maps_api_key
GEOCODING_API_KEY=your_geocoding_api_key
ROUTES_API_KEY=your_routes_api_key
PLACES_API_KEY=your_places_api_key

# Qwen Cloud itinerary generation (OpenAI-compatible Responses API)
QWEN_ENDPOINT=https://us-east-1.maas.qwencloudapi.com/compatible-mode/v1
QWEN_API_KEY=your_qwen_api_key
QWEN_MODEL=qwen3.6-35b-a3b
QWEN_TIMEOUT_MS=90000

# Other API keys, secrets, and configurations
